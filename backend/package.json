{
  "name": "birla-heritage-backend",
  "version": "1.0.0",
  "description": "Offline SQLite API for Birla Heritage school admission & contact forms",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/initDb.js",
    "db:migrate": "node scripts/initDb.js",
    "db:seed": "node scripts/seed.js",
    "db:backup": "node scripts/backup.js",
    "seed:announcements": "node scripts/seedAnnouncements.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node scripts/smokeTest.js",
    "test:integration": "node scripts/integrationTest.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "sql.js": "^1.12.0",
    "zod": "^3.24.1"
  }
}
