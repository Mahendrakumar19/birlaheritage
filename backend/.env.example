NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_DRIVER=sqlite
DB_PATH=./data/school.db
# DATABASE_URL=postgresql://user:password@localhost:5432/birla_heritage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
PII_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
COOKIE_DOMAIN=
TRUST_PROXY=loopback
ALLOW_ADMIN_SIGNUP=false
BOOTSTRAP_ADMIN_TOKEN=
# Legacy development-only API key. Never enable in production.
ADMIN_API_KEY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BACKUP_DIR=./backups
